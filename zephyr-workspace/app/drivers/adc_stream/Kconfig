menuconfig ADC_STREAM_RPI_PICO
	bool "RP2350 continuous ADC + DMA streaming driver"
	default y
	depends on DT_HAS_RASPBERRYPI_PICO_ADC_STREAM_ENABLED
	select DMA
	help
	  App-local driver (app/drivers/adc_stream/, not an upstream Zephyr
	  driver) that free-runs the RP2350 ADC into ping-pong DMA buffers
	  for continuous acquisition. See ZEPHYR_MIGRATION.md, Phase 1b.

if ADC_STREAM_RPI_PICO

config ADC_STREAM_RPI_PICO_INIT_PRIORITY
	int "Init priority"
	default KERNEL_INIT_PRIORITY_DEVICE
	help
	  Must sort after CONFIG_DMA_INIT_PRIORITY (KERNEL_INIT_PRIORITY_DEFAULT
	  by default) — adc_stream_init() calls device_is_ready() on the DMA
	  controller device.

config ADC_STREAM_BUFFER_SIZE
	int "Samples per ping-pong half-buffer"
	default 1024
	help
	  Mirrors main:firmware/hal/hal_adc.h's HAL_ADC_BUFFER_SIZE. Must equal
	  services/dsp's FFT window size N so one completed DMA block is
	  exactly one FFT window — see dsp.h on main.

config ADC_STREAM_SAMPLE_RATE_HZ
	int "Sample rate in Hz"
	default 10240
	help
	  Mirrors main:firmware/bsp/rp2350/board_config.h's ADC_SAMPLE_RATE:
	  50*N/FS lands on exact FFT bins for 50 Hz harmonics.

module = ADC_STREAM_RPI_PICO
module-str = adc stream
source "subsys/logging/Kconfig.template.log_config"

endif # ADC_STREAM_RPI_PICO
